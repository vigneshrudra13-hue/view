CREATE TABLE expenses (
    id INTEGER PRIMARY KEY,
    place TEXT NOT NULL,
    amount TEXT UNIQUE,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);












CREATE TABLE Passenger (
PNR_No INTEGER PRIMARY KEY,
Passenger_Name TEXT not NULL,
Age INTEGER,
Gender text,
Ticket_No INTEGER,
Address text(50),
Phone_No text(50)
);



CREATE TABLE Passengers_1NF (
PNR_No INTEGER,
Passenger_Name TEXT(20),
Age INTEGER,
Gender TEXT(1),
Ticket_No INTEGER,
Address TEXT(50),
Phone_No TEXT(15)
);




CREATE TABLE Passenger_2NF (
Passenger_ID INTEGER PRIMARY KEY,
Passenger_Name TEXT(20),
Age INTEGER,
Gender TEXT(1),
Address TEXT(50)
);

CREATE TABLE Passenger_Phone_2NF (
Passenger_ID INTEGER,
Phone_No TEXT(15),
FOREIGN KEY (Passenger_ID) REFERENCES Passenger_2NF(Passenger_ID)
);

CREATE TABLE Ticket_2NF (
Ticket_No INTEGER PRIMARY KEY,
Passenger_ID INTEGER,
FOREIGN KEY (Passenger_ID) REFERENCES Passenger_2NF(Passenger_ID)
);



